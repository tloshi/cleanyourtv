<?xml version="1.0" encoding="utf-8"?>
<!-- The cards under the clock (forecast_widget, calendar_widget): a flat dark surface with a hairline border, the
     wallpaper faintly through it. No blur, like the pills: a 1 GB TV draws it as one rounded rectangle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#DB12161F" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
    <corners android:radius="24dp" />
</shape>
