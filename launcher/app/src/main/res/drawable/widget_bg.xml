<?xml version="1.0" encoding="utf-8"?>
<!-- The cards under the clock (forecast_widget, calendar_widget): dark glass with a faint rim, so the wallpaper
     shows through. No blur, like the pills: a 1 GB TV draws it as one rounded rectangle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#780A1020" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
    <corners android:radius="22dp" />
</shape>
